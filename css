@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Merriweather:ital@1&display=swap');

div {
    text-align: center;
}

body {
    background-color: #8dd1e7;
    font-family: 'Roboto', sans-serif;
    color: #222;
    margin: 0;
    padding: 20px;
}

#openModalBtn {
    background-color: #0066cc;
    color: white;
    padding: 10px 15px;
    border: none;
    font-weight: bold;
    cursor: pointer;
    border-radius: 5px;
}

.contato, .habilidades, .resumo, .experiencia, .Educação {
    background-color: white;
    padding: 15px;
    margin-top: 20px;
    border-radius: 8px;
    box-shadow: 0 0 5px rgba(0,0,0,0.1);
}
figure {
    text-align: center;
}

.item-experiencia, .item-educacao {
    margin-bottom: 15px;
}

.periodo {
    font-style: italic; /* estilo de fonte */
    color: #555;
}

input[type="text"], input[type="url"], input[type="tel"] {
    border: 2px solid #0066cc;
    padding: 8px;
    border-radius: 5px;
    width: 250px;
}

a:hover {
    color: #ff6600;
    text-decoration: underline;
}


h1 {
    text-decoration: underline;
    font-family: 'Merriweather', serif;
}


h2 {
    color: #08315a;
    font-weight: bold;
}

button:hover {
    background-color: #004c99;
}